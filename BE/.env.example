# TaskHub Backend - Environment Configuration
# Copy this file to `.env` and fill in your real values.
# IMPORTANT: Never commit `.env` to version control.

# ── Profile ─────────────────────────────────────────────────────
# dev         : H2 in-memory (no DB needed, great for quick local dev)
# supabase    : Supabase Postgres (requires SPRING_DATASOURCE_PASSWORD below)
# postgres    : Local/self-hosted PostgreSQL via docker-compose
SPRING_PROFILES_ACTIVE=supabase

# ── Supabase Postgres ───────────────────────────────────────────
# Get password from: Supabase Dashboard → Settings → Database → Database password
# Leave blank to use the default fallback below (only for first-time setup).
SPRING_DATASOURCE_URL=jdbc:postgresql://db.wwduzspwejdyvbnjxkkz.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# ── JWT ─────────────────────────────────────────────────────────
# Must be at least 32 bytes. Change this to a random string in production.
APP_JWT_SECRET=TaskHub2026SuperSecureSecretKeyAtLeast32Bytes!!

# ── Email (Gmail SMTP) ─────────────────────────────────────────
APP_EMAIL_ENABLED=true
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=ptiendat475@gmail.com
SPRING_MAIL_PASSWORD=

# ── Admin (auto-seeded on first startup) ─────────────────────
APP_ADMIN_ENABLED=true
APP_ADMIN_EMAIL=admin@taskhub.com
APP_ADMIN_PASSWORD=Admin@TaskHub2026
APP_ADMIN_FULL_NAME=TaskHub Admin

# ── SMS (Twilio) ───────────────────────────────────────────────
APP_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# ── Base URL ───────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
