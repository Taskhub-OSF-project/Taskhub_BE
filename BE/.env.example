# TaskHub Backend - local environment example
# Copy this file to `.env`, fill in private values, and never commit `.env`.

# Use `dev` for H2 local development or `supabase` for PostgreSQL production-like testing.
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL (required only with the supabase profile)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Generate a unique random value of at least 32 bytes. Never reuse this placeholder.
APP_JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes

# Google Identity Services. This public Web client ID must match the frontend
# VITE_GOOGLE_CLIENT_ID so the backend verifies the same token audience.
APP_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# AWS Bedrock Claude Haiku 4.5
APP_BEDROCK_ENABLED=true
APP_BEDROCK_REGION=us-east-1
APP_BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Security email. Use Resend while SES production access is pending, then switch
# APP_MAIL_PROVIDER to ses without changing the OTP flow.
APP_EMAIL_ENABLED=false
APP_MAIL_DELIVERY_ENABLED=false
APP_MAIL_PROVIDER=resend
APP_MAIL_FROM_EMAIL="TaskHub <otp@mail.taskhubvn.com>"
APP_MAIL_RESEND_API_KEY=
APP_MAIL_RESEND_ENDPOINT=https://api.resend.com/emails
APP_MAIL_REGION=us-east-1

# Admin seeding is intentionally disabled. Use a unique private password if explicitly enabled.
APP_ADMIN_ENABLED=false
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_ADMIN_FULL_NAME=TaskHub Admin

# SMS recovery (Twilio)
APP_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Frontend/local URLs
APP_FRONTEND_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# Supabase Storage (server-side only; never expose the service-role key to frontend code)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SePay Payment Gateway (VietQR Automatic Bank Webhook)
APP_SEPAY_API_TOKEN=your_sepay_secret_api_token
APP_SEPAY_BANK_ACCOUNT=0123456789
APP_SEPAY_BANK_NAME=MBBank
APP_SEPAY_ACCOUNT_NAME=TASKHUB PLATFORM
APP_SEPAY_QR_TEMPLATE=compact
