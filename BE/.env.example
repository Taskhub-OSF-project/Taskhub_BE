# TaskHub Backend - Email + SMS Configuration
# Copy this file to `.env` and fill in your real values.
# IMPORTANT: Never commit `.env` to version control.

# Supabase / runtime profile
SPRING_PROFILES_ACTIVE=supabase
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.wwduzspwejdyvbnjxkkz
SPRING_DATASOURCE_PASSWORD=your-supabase-db-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_FLYWAY_ENABLED=false

SUPABASE_URL=https://wwduzspwejdyvbnjxkkz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=taskhub-submissions

# ── Email (Gmail SMTP) ───────────────────────────────────────────
# Enable real email sending (set to true to use SMTP, false for mock mode)
APP_EMAIL_ENABLED=false

# Gmail SMTP settings (defaults shown — only override if needed)
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587

# Your Gmail address (the sender)
SPRING_MAIL_USERNAME=your.email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate at https://myaccount.google.com/apppasswords
# Must be 16 characters, e.g.: abcd efgh ijkl mnop
# Remove the spaces when pasting here
SPRING_MAIL_PASSWORD=abcdefghijklmnop

# ── Admin (auto-seeded on first startup) ───────────────────────
# Set APP_ADMIN_ENABLED=false to disable auto-creation of the default admin.
APP_ADMIN_ENABLED=true
# IMPORTANT: Change these before deploying to production!
APP_ADMIN_EMAIL=admin@taskhub.com
APP_ADMIN_PASSWORD=Admin@TaskHub2026
APP_ADMIN_FULL_NAME=TaskHub Admin

# ── SMS (Twilio) ────────────────────────────────────────────────
# Enable real SMS sending (set to true to use Twilio, false for mock mode)
APP_SMS_ENABLED=false

# Twilio credentials
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Twilio phone number (with country code, e.g. +1234567890)
TWILIO_PHONE_NUMBER=+1234567890

# ── Base URL ───────────────────────────────────────────────────
# Used to build password-reset / email-verification links in emails
APP_BASE_URL=http://localhost:5173
