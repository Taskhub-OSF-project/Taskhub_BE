# TaskHub Backend - Email Configuration (Gmail example)
# Copy this file to `.env` and fill in your real values.
# IMPORTANT: Never commit `.env` to version control.

# Enable real email sending (set to true to use SMTP, false for mock mode)
APP_EMAIL_ENABLED=true

# Gmail SMTP settings (defaults shown — only override if needed)
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587

# Your Gmail address (the sender)
SPRING_MAIL_USERNAME=your.email@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# Generate at https://myaccount.google.com/apppasswords
# Must be 16 characters, e.g.: abcd efgh ijkl mnop
# Remove the spaces when pasting here
SPRING_MAIL_PASSWORD=abcdefghijklmnop

# Base URL used to build password-reset / email-verification links
APP_BASE_URL=http://localhost:5173